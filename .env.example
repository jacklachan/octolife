DATABASE_URL=sqlite:///./octolife.db
LLM_PROVIDER=mock
# Local LLM: set LLM_PROVIDER=ollama (needs `ollama serve` and `ollama pull qwen2.5:1.5b`)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT=120
# OLLAMA_NUM_GPU=0   # uncomment to force CPU-only inference
USER_EMAIL=student@localhost
USER_NAME=Student
USER_TIMEZONE=Asia/Kolkata
# JSON list of local feed files for the Internship agent
JOB_FEED_PATHS=["samples/jobs.json"]
SCHEDULER_ENABLED=true
